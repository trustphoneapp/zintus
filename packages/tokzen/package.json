{
  "name": "tokzen",
  "version": "0.1.0",
  "description": "Token-efficient LLM context compression. TypeScript-native.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ml": {
      "types": "./dist/ml/llmlingua.d.ts",
      "import": "./dist/ml/llmlingua.js",
      "require": "./dist/ml/llmlingua.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "tokzen-mcp": "./dist/mcp/server.js"
  },
  "files": ["dist", "grammars", "src/mcp"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "bun test tests/",
    "postinstall": "bun run scripts/postinstall.ts 2>/dev/null || true"
  },
  "dependencies": {
    "gpt-tokenizer": "3.4.0",
    "@anthropic-ai/sdk": "0.105.0"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.25.10"
  },
  "peerDependenciesMeta": {
    "web-tree-sitter": {
      "optional": true
    },
    "@toon-format/toon": {
      "optional": true
    },
    "drain3-js": {
      "optional": true
    },
    "@atjsh/llmlingua-2": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tree-sitter-wasms": "0.1.13",
    "tsup": "8.5.1",
    "web-tree-sitter": "0.25.10"
  }
}
