{
  "$comment": "Zintus declarative routing policy. Place at repo root or ~/.zintus/policy.json (or point $ZINTUS_POLICY at it). Gateway/CLI hot-reload on change. Every field is optional; missing fields fall back to built-in defaults.",
  "providerPriority": [
    "cerebras",
    "groq",
    "gemini",
    "fireworks",
    "xai",
    "huggingface",
