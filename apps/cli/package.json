{
  "name": "zintus",
  "version": "0.2.0",
  "description": "Multi-provider AI CLI — route chat, code, and agent workloads across providers with quota-aware failover.",
  "license": "BUSL-1.1",
  "type": "module",
  "bin": {
    "zintus": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "ai",
    "cli",
    "llm",
    "chat",
    "agent",
    "openai",
    "anthropic",
    "groq",
    "gemini",
    "router",
    "multi-provider"
  ],
  "homepage": "https://zintus.ai",
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --target=bun --outfile=dist/cli.js --external @napi-rs/keyring --external sqlite-vec --external ws --minify",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build",
    "build:binaries": "bun scripts/build-binaries.ts",
    "build:binaries:smoke": "bun scripts/build-binaries.ts --smoke",
    "prepare:npm": "bun scripts/build-binaries.ts && bun scripts/prepare-npm.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "sqlite-vec": "^0.1.9",
    "ws": ">=8.21.0",
    "@zintus/agent": "workspace:*",
    "@zintus/scaffold": "workspace:*"
  },
  "devDependencies": {
    "@clack/prompts": "^0.10.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@zintus/codebase-indexer": "workspace:*",
    "@zintus/context-compiler": "workspace:*",
    "@zintus/engine": "workspace:*",
    "@zintus/gateway": "workspace:*",
    "@zintus/keychain": "workspace:*",
    "@zintus/mcp": "workspace:*",
    "@zintus/media": "workspace:*",
    "@zintus/memory": "workspace:*",
    "@zintus/providers": "workspace:*",
    "@zintus/router": "workspace:*",
    "@zintus/search": "workspace:*",
    "@zintus/types": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.0",
    "ink": "^6",
    "ora": "^8.2.0",
    "react": "^19.2.0",
    "tokzen": "workspace:*"
  }
}
