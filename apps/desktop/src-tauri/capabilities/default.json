{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.zintus.desktop",
  "description": "Zintus desktop capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "core:window:allow-minimize",
      "comment": "Custom caption buttons on the undecorated Windows build (WindowControls.tsx); Tauri's Overlay titlebar is macOS-only."
    },
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "pty:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "comment": "Exports go to a user-chosen path from the native save dialog; scope it to the user's own save locations rather than the whole filesystem (no system paths).",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    }
  ]
}
