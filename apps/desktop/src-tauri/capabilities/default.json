{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.zintus.desktop",
  "description": "Zintus desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "pty:default",
    "updater:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
