<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime entitlements for Developer ID signing/notarization.
       Without these, the SIGNED app breaks in two ways the unsigned dev build
       never shows: getUserMedia (voice input) is denied without audio-input,
       and the bun-compiled gateway sidecar (JavaScriptCore JIT) crashes on
       launch without the JIT/unsigned-memory pair. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
