<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Voice input v1: the composer mic records locally and transcribes via the
       local gateway with the user's own Groq key. Required for getUserMedia in
       the packaged webview. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Zintus uses the microphone for voice input — audio goes only to your local gateway and your own transcription key, never to Zintus servers.</string>
  <!-- Loopback (our gateway/Ollama) is normally exempt from the Local Network
       prompt, but macOS 26 has known bugs blocking localhost, and users may
       point OLLAMA_HOST at another machine — honest text either way. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Zintus talks to your local AI gateway and local model runtimes (like Ollama) on this Mac or your network. Nothing is sent to Zintus servers.</string>
</dict>
</plist>
