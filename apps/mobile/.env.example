# Zintus mobile (Expo) environment variables.
# Copy to .env (gitignored). Only EXPO_PUBLIC_* vars are exposed to the app, and
# they are INLINED at build time — set them before `eas build`, not after.

# Validate URL — the deployed web `/api/validate` (Cloudflare Worker / Vercel).
# REQUIRED for store builds. Used by lib/limits.ts to check entitlements/quota.
# If unset it defaults to http://localhost:3000/api/validate, which a shipped app
# cannot reach — limit checks will fail for every user. In CI this comes from the
# repo var `EXPO_PUBLIC_VALIDATE_URL` (see .github/workflows/release-mobile.yml).
EXPO_PUBLIC_VALIDATE_URL=https://zintus.ai/api/validate

# Zintus Cloud relay base URL. OPTIONAL — defaults to https://relay.zintus.ai
# (lib/cloud.ts). Only override to point at a self-hosted/staging relay. If unset
# the app uses the production relay, which is correct for store builds.
# EXPO_PUBLIC_RELAY_URL=https://relay.zintus.ai

# Gateway base URL. OPTIONAL — by default the app auto-detects the dev machine
# from the Metro bundler host (a LAN IP, or 10.0.2.2 on the Android emulator),
# and you can also set the URL in-app under Settings → Gateway. Only set this to
# pin a fixed URL (e.g. a production gateway). On a device/simulator, localhost
# is the device itself — use your machine's LAN IP (e.g. http://192.168.1.20:8788).
# EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.20:8788

# Bearer token sent to the gateway. Leave unset for local-only use; set it (to
# the gateway's GATEWAY_TOKEN) when the gateway requires auth.
# EXPO_PUBLIC_GATEWAY_TOKEN=replace-with-the-gateway-token
