# Zintus mobile (Expo) environment variables.
# Copy to .env (gitignored). Only EXPO_PUBLIC_* vars are exposed to the app.

# Gateway base URL. OPTIONAL — by default the app auto-detects the dev machine
# from the Metro bundler host (a LAN IP, or 10.0.2.2 on the Android emulator),
# and you can also set the URL in-app under Settings → Gateway. Only set this to
# pin a fixed URL (e.g. a production gateway). On a device/simulator, localhost
# is the device itself — use your machine's LAN IP (e.g. http://192.168.1.20:8788).
# EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.20:8788

# Bearer token sent to the gateway. Leave unset for local-only use; set it (to
# the gateway's GATEWAY_TOKEN) when the gateway requires auth.
# EXPO_PUBLIC_GATEWAY_TOKEN=replace-with-the-gateway-token
