# Web app environment variables

# Local gateway for CLI keychain routing (default: http://localhost:8788)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8788

# Bearer token the web app sends to the gateway. Leave unset for local-only use;
# set it (to the same value as the gateway's GATEWAY_TOKEN) when the gateway is
# exposed on a network and requires auth.
# NEXT_PUBLIC_GATEWAY_TOKEN=replace-with-the-gateway-token

# Cloudflare validate-key worker URL (required for production validate on Vercel)
WORKER_VALIDATE_URL=https://your-worker.workers.dev/validate

# Alternate env name also supported
# VALIDATE_WORKER_URL=

# Optional server-side quota ledger path
# ZINTUS_QUOTA_PATH=/tmp/zintus-quota.db

# --- Zintus Cloud dashboard -----------------------------------------------
# URL of the relay Cloudflare Worker. The dashboard pages (/login, /dashboard)
# call this API for auth and session management.
NEXT_PUBLIC_RELAY_URL=https://relay.zintus.ai
