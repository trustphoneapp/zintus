{
  "name": "@zintus/gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zintus/engine": "workspace:*",
    "@zintus/providers": "workspace:*",
    "@zintus/router": "workspace:*",
    "@zintus/types": "workspace:*",
    "tokzen": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
