# Zintus gateway configuration.
# Copy to .env (gitignored) and adjust. All values are optional.

# Port to listen on (default 8788).
GATEWAY_PORT=8788

# Interface to bind. Defaults to 127.0.0.1 (loopback only).
# Binding to 0.0.0.0 / :: is REFUSED unless GATEWAY_TOKEN is also set.
GATEWAY_HOST=127.0.0.1

# Bearer token required on every API request (except /health).
# Leave unset for local-only use; REQUIRED to expose the gateway on a network.
# Clients send:  Authorization: Bearer <token>
# GATEWAY_TOKEN=replace-with-a-long-random-secret

# CORS allowlist (comma-separated origins). Unset or "*" allows any origin.
# For a network/production deploy, set this to your web app origin(s) so the
# browser can call the gateway; everything else is rejected.
# GATEWAY_CORS_ORIGIN=https://your-web-app.example.com

# Request limits (all optional; defaults shown).
# Reject bodies larger than this many bytes with HTTP 413.
# GATEWAY_MAX_BODY_BYTES=1000000
# Reject requests with more than this many messages with HTTP 413.
# GATEWAY_MAX_MESSAGES=200
# Abort a chat that takes longer than this to start streaming, with HTTP 408.
# GATEWAY_REQUEST_TIMEOUT_MS=60000

# Opt in to LLM-assisted memory summarization (extra provider calls + cost).
# Default is deterministic, offline summarization.
# MEMORY_LLM=1

# --- Declarative routing policy -------------------------------------------
# Path to policy.json (provider priority, weights, model groups, fallbacks,
# limits). Defaults: ~/.zintus/policy.json, then ./policy.json. Hot-reloaded.
# ZINTUS_POLICY=/etc/zintus/policy.json

# --- Observability: OpenTelemetry traces (Phase 4.1) ----------------------
# When set, each request is exported as an OTLP/HTTP JSON trace (parent
# chat.request span + one provider.attempt child span per routing attempt).
# Point at a collector's traces endpoint (base or .../v1/traces both work).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=zintus-gateway

# --- Background provider health probe (Phase 5.3) -------------------------
# When set (>= 1000 ms), periodically validate each keyed provider's key so an
# unreachable provider is demoted by health-aware routing before a real request
# hits it. Off by default. Recommended: 300000 (5 min).
# PROVIDER_PROBE_INTERVAL_MS=300000

# --- Response cache --------------------------------------------------------
# L2 semantic cache needs Ollama nomic-embed-text; otherwise L1-only.
# CACHE_L2=1
# Send `Cache-Control: no-cache` on a chat request to bypass the cache.

# --- Smart Context Engine: codebase indexing ------------------------------
# Point at a local workspace to index for codebase-aware context. When set, the
# engine indexes the directory (idempotent: sha256 + mtime) and injects relevant
# code into threaded requests, quota-sized to the routed model's context window.
# Off when unset. Clients can also send per-turn `diff`/`terminal` in the body.
# ZINTUS_WORKSPACE=/path/to/your/repo

# --- Zintus Cloud (outbound relay) ----------------------------------------
# When set, `zintus serve --cloud` opens an outbound WebSocket to the relay
# Durable Object. Keys and routing decisions never leave this machine.
# Obtain via: zintus cloud login
# ZINTUS_SESSION_ID=
# ZINTUS_GATEWAY_SECRET=
# ZINTUS_RELAY_URL=https://zintus-relay.yashwanth-surabhi.workers.dev
