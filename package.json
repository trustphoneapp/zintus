{
  "name": "multipleai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "typecheck": "tsc --build tsconfig.build.json && bun run --filter '@multipleai/web' --filter '@multipleai/desktop' --filter '@multipleai/mobile' typecheck",
    "test": "vitest run && bun test packages/router/src/factory.test.ts packages/router/src/quota-ledger.test.ts apps/web/lib/chat.test.ts",
    "test:watch": "vitest",
    "dev": "bun run --filter multipleai dev",
    "dev:cli": "bun run --filter multipleai dev",
    "dev:web": "bun run --filter @multipleai/web dev",
    "dev:desktop": "bun run --filter @multipleai/desktop dev",
    "dev:mobile": "bun run --filter @multipleai/mobile dev",
    "build": "bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
