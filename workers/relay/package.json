{
  "name": "@zintus/relay-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --message \"$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty)\"",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute zintus-relay --file=schema.sql"
  },
  "dependencies": {
    "@zintus/schemas": "workspace:*",
    "@zintus/search": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@noble/curves": "^2.2.0",
    "@zintus/crypto-e2e": "workspace:*",
    "wrangler": "^4.0.0"
  }
}
