# Copy to .dev.vars for local wrangler dev (never commit secrets)

RELAY_AUTH_SECRET=generate_with_openssl_rand_hex_32
RELAY_BASE_URL=http://localhost:8787
COOKIE_DOMAIN=

# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — get key at resend.com
RESEND_API_KEY=re_your_key_here

# Stripe — get keys at dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_FILL_FROM_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_FILL_FROM_STRIPE

# Managed key encryption — generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=generate_with_openssl_rand_hex_32

# Zintus master API keys for Pro tier (leave blank until configured)
ZINTUS_GROQ_KEY=
ZINTUS_DEEPSEEK_KEY=
ZINTUS_GEMINI_KEY=
ZINTUS_CEREBRAS_KEY=
ZINTUS_OPENROUTER_KEY=
ZINTUS_COHERE_KEY=
ZINTUS_MISTRAL_KEY=
